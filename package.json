{
  "name": "bongo-philharmonic",
  "version": "0.1.0",
  "description": "Bongo Philharmonic — place a band, compose its music, and watch it perform",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "resources:verify": "node scripts/verify-resource-versions.mjs",
    "test": "vitest run",
    "test:web": "playwright test",
    "verify": "npm run build && npm test && npm run test:web",
    "build:public": "tsc --noEmit && vite build --mode public-site --config vite.public.config.ts && node scripts/verify-public-build.mjs",
    "preview:public": "vite preview --config vite.public.config.ts",
    "test:web:public": "playwright test --config playwright.public.config.ts",
    "prepare:site": "node scripts/prepare-public-site.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
